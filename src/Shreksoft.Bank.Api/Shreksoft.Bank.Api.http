@Api_HostAddress = http://localhost:5294
@Idp_HostAddress = https://demo.duendesoftware.com

###
# @name GetToken
POST {{Idp_HostAddress}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=m2m.short&client_secret=secret&scope=api

> {%
    client.global.set("token", response.body.access_token);
 %}

###
# @name CreateClient
POST {{Api_HostAddress}}/api/clients/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "firstName": "Иван",
    "middleName": null,
    "lastName": "Петров",
    "birthDate": "1998-07-21",
    "email": "ivan@example.com",
    "phoneNumber": "+79991234567"
}

> {%
    client.global.set("clientId", response.body.id);
%}

###
GET {{Api_HostAddress}}/api/clients/{{clientId}}
Content-Type: application/json
Authorization: Bearer {{token}}

###
POST {{Api_HostAddress}}/api/Account/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "clientId": "{{clientId}}",
    "currencyCode": 2
}

> {%
 client.global.set("accountId", response.body.id);
%}

###
GET {{Api_HostAddress}}/api/Account/{{accountId}}
Content-Type: application/json
Authorization: Bearer {{token}}

###
POST {{Api_HostAddress}}/api/Account/Transfer
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "senderAccId": "{{accountId}}",
    "recipientAccId": "dab242c6-b825-467d-9229-eec767a60319",
    "amount": 22
}


###
PUT {{Api_HostAddress}}/api/Account/Deposit
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "accountId": "{{accountId}}",
    "amount": 300
}
